# Configure the API URL for the intended environment; this is local only.
VITE_API_BASE_URL=http://localhost:5000

# Default: MicroChannel uses the legacy payload; container mode is unavailable.
# Set line-container ONLY after verifying the updated API AND its SQL migration.
VITE_SCANNING_CONTRACT=legacy

# Real positive IDs from GET /api/Lines/getLines (do not derive IDs from line names).
# Required for BOTH processes when VITE_SCANNING_CONTRACT=line-container.
VITE_MICROCHANNEL_LINE_ID=
VITE_LINE4_EMPAQUES_LINE_ID=
